<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_black"
    android:orientation="vertical">

    <!-- Minimal Editor Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_accent"
            android:paddingHorizontal="16dp"
            android:text="@string/save_script"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Deep Dark Monospace Editor Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/deep_black"
        android:fillViewport="true">

        <EditText
            android:id="@+id/script_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:inputType="textLongMessage|textMultiLine|textNoSuggestions"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textCursorDrawable="@null"
            android:textSize="13sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
